<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ✅ 新增：声明需要查询的包，Android 11+ 必须加，否则 resolveActivity() 强制返回 null -->
    <queries>
        <package android:name="com.coloros.safecenter" />
        
    
        <!-- 补充：让 resolveActivity() 能查到系统 Settings 里的各类权限页 -->
        <package android:name="com.android.settings" />
        <package android:name="com.android.permissioncontroller" />
        <package android:name="com.oplus.securitypermission" />


    </queries>

    <!-- ✅ 新增：麦克风/相机/位置/电话/联系人/日历改成本 App 内展示"哪些应用申请了该权限"的
         列表，需要枚举全部已安装应用，Android 11+ 必须声明该权限才能拿到完整包列表
         （否则 getInstalledPackages 只能看到 <queries> 里列出的少数包）。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PermissionManager">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ✅ 新增：麦克风/相机/位置/电话/联系人/日历点击后展示的"应用列表"页 -->
        <activity
            android:name=".AppListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>
